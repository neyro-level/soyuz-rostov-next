limit_req_zone $binary_remote_addr zone=souz_rostov_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=souz_rostov_leads:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=souz_rostov_internal:10m rate=30r/m;

server {
    listen 443 ssl http2;
    server_name soyuz-rostov.tw1.ru;

    client_max_body_size 20m;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    ssl_certificate __TECH_TLS_CERTIFICATE_PATH__;
    ssl_certificate_key __TECH_TLS_PRIVATE_KEY_PATH__;

    include /etc/nginx/snippets/souz-rostov-proxy-locations.conf;
}

server {
    listen 443 ssl http2;
    server_name souz-home.ru www.souz-home.ru;

    client_max_body_size 20m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    # Keep this while productionIndexing is noindex. Remove only after public indexing promotion.
    add_header X-Robots-Tag "noindex, nofollow" always;

    ssl_certificate __FINAL_TLS_CERTIFICATE_PATH__;
    ssl_certificate_key __FINAL_TLS_PRIVATE_KEY_PATH__;

    include /etc/nginx/snippets/souz-rostov-proxy-locations.conf;
}

