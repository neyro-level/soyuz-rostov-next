{
	"schemaVersion": 2,
	"cloneRuntimeScope": [
		{ "path": "src", "type": "tree" },
		{ "path": "packages", "type": "tree" },
		{ "path": "migrations", "type": "tree" },
		{ "path": "scripts", "type": "tree" },
		{ "path": "deploy", "type": "tree" },
		{ "path": "public", "type": "tree" },
		{ "path": ".dockerignore", "type": "file" },
		{ "path": "Dockerfile", "type": "file" },
		{ "path": "instrumentation.ts", "type": "file" },
