			{ "path": "src/app/(payload)", "type": "tree", "except": ["src/app/(payload)/admin/importMap.d.ts", "src/app/(payload)/admin/importMap.js"] },
			{ "path": "src/app/api/internal", "type": "tree" },
			{ "path": "src/app/api/public/leads/route.ts", "type": "file" },
			{ "path": "src/app/layout.tsx", "type": "file" },
			{ "path": "src/app/not-found.tsx", "type": "file" },
			{ "path": "src/app/robots.txt/route.ts", "type": "file" },
			{ "path": "src/app/sitemap.ts", "type": "file" },
			{ "path": "src/app/globals.css", "type": "file" },
			{ "path": "src/project/brand.css", "type": "file" },
			{ "path": "src/project/cache", "type": "tree" },
			{ "path": "src/project/collections", "type": "tree" },
			{ "path": "src/project/data-access", "type": "tree" },
			{ "path": "src/project/jobs", "type": "tree" },
			{ "path": "src/project/routing", "type": "tree" },
