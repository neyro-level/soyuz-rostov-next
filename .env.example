# Public, non-secret defaults
AMS_PROFILE=REALTY_BASE
TZ=Europe/Moscow
JOBS_AUTORUN=false
CACHE_INVALIDATION_MODE=http
PAYLOAD_DB_PUSH=false

# Runtime identity
NEXT_PUBLIC_SERVER_URL=
INTERNAL_REVALIDATE_BASE_URL=

# Infrastructure (values are provided outside Git)
# Secret values live in Secret Master / self-hosted Infisical:
# https://infisical.ams24.ru
# Starter runtime uses local PostgreSQL + MEDIA_DIR. S3_* is not required.
DATABASE_URI=
DATABASE_URI_TEST=
DATABASE_POOL_MAX=
PAYLOAD_SECRET=
REVALIDATE_SECRET=
REVALIDATE_RATE_LIMIT_PER_MINUTE=30
INTERNAL_HEALTH_SECRET=
MEDIA_DIR=

# Allowlists and integrations
OUTBOUND_ALLOWED_HOSTS=
EXTERNAL_IMAGE_HOSTS=
ANALYTICS_PROVIDER=
HSTS_PRELOAD=false
LEAD_CHANNELS=
LEAD_OUTBOUND_HOSTS=
MAX_BOT_TOKEN=
MAX_CHAT_ID=
MAX_API_URL=
CUSTOM_WEBHOOK_URL=
CUSTOM_WEBHOOK_HMAC_SECRET=
LEAD_RATE_LIMIT_PER_MINUTE=
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=

# Mandatory owner/legal decisions; no silent defaults
ARCHIVE_RETENTION_DAYS=
ALERT_WEBHOOK_URL=
BACKUP_STATUS_PATH=
